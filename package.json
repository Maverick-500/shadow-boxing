{
  "name": "hoi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "measure": "esbuild scripts/measure-run.ts --bundle --platform=node --format=esm --log-level=warning --outfile=dist/measure-run.mjs && node dist/measure-run.mjs",
    "check:run": "esbuild scripts/check-run.ts --bundle --platform=node --format=esm --log-level=warning --outfile=dist/check-run.mjs && node dist/check-run.mjs",
    "panels": "esbuild scripts/panels.ts --bundle --platform=node --format=esm --log-level=warning --outfile=dist/panels.mjs && node dist/panels.mjs",
    "itch": "npm run build && cd dist && rm -f ../hoi-itch.zip && zip -qr ../hoi-itch.zip . && cd .. && echo \"wrote hoi-itch.zip, upload this to itch.io\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.5"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22",
    "@neondatabase/serverless": "^1.2.0"
  }
}
